#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 3 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <40>;       // 300
    delay-ms = <16>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    macros {
        flash_macro: flash_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bootloader>;
        };
    };

    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            hold-trigger-key-positions = <21 22 23>;
            hold-trigger-on-release;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "RGB_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <30>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            hold-trigger-key-positions = <17 16 15 14>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        left_bkt {
            bindings = <&kp LS(GREATER_THAN)>;
            key-positions = <30 31>;
        };

        right_bkt {
            bindings = <&kp LS(SLASH)>;
            key-positions = <33 34>;
        };

        left_par {
            bindings = <&kp NUMBER_9>;
            key-positions = <17 18>;
        };

        right_par {
            bindings = <&kp NUMBER_0>;
            key-positions = <21 20>;
        };

        left_brace {
            bindings = <&kp LS(GREATER_THAN)>;
            key-positions = <30 31>;
        };

        right_brace {
            bindings = <&kp LS(SLASH)>;
            key-positions = <34 33>;
        };

        less {
            bindings = <&kp RA(O)>;
            key-positions = <3 4>;
        };

        more {
            bindings = <&kp RA(P)>;
            key-positions = <8 9>;
        };

        left_round_par {
            bindings = <&kp GREATER_THAN>;
            key-positions = <30 29>;
        };

        right_round_par {
            bindings = <&kp SLASH>;
            key-positions = <34 35>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Qwery {
            bindings = <
&none  &kp Q            &kp W            &kp E              &kp R                &hmr RA(T) T                &kp UP_ARROW     &kp Y          &kp U                 &hmr RA(I) I        &kp O            &kp P                     &studio_unlock
&none  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_SHIFT D  &hml LEFT_CONTROL F  &kp G                       &kp DOWN_ARROW   &kp H          &hmr RIGHT_CONTROL J  &hmr RIGHT_SHIFT K  &hmr LEFT_ALT L  &hmr RIGHT_GUI SEMICOLON  &none
&none  &kp Z            &kp X            &kp C              &kp V                &kp B                       &kp LEFT_ARROW   &kp N          &hmr LA(M) M          &kp COMMA           &kp DOT          &kp SLASH                 &none
                        &to 4            &kp TAB            &ltq 2 SPACE         &hmr LEFT_CONTROL DELETE    &kp RIGHT_ARROW  &kp BACKSPACE  &mo 1                 &kp ENTER
                                                                                                             &to 5
            >;

            label = "Qwery";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Symbol {
            bindings = <
&none         &kp BACKSLASH                &kp RA(GRAVE)        &kp NUMBER_7                &kp NUMBER_1                   &kp SEMI          &trans  &kp PLUS   &kp LS(NUMBER_1)                 &kp LS(NUMBER_2)         &kp LS(NUMBER_3)             &kp NUMBER_3           &none
&kp N5        &hml LEFT_GUI LS(BACKSLASH)  &hml LEFT_ALT GRAVE  &hml LEFT_SHIFT LEFT_BRACE  &hml LEFT_CONTROL RIGHT_BRACE  &kp NUMBER_2      &trans  &kp MINUS  &hmr RIGHT_CONTROL LS(NUMBER_4)  &hmr RIGHT_SHIFT LS(N5)  &hmr RIGHT_ALT LS(NUMBER_6)  &hmr RIGHT_GUI LS(N0)  &kp NUMBER_4
&kp NUMBER_6  &kp RA(BACKSLASH)            &kp LS(GRAVE)        &kp LS(LEFT_BRACE)          &kp LS(RIGHT_BRACE)            &kp UNDERSCORE    &trans  &kp EQUAL  &kp LS(N7)                       &kp LS(N8)               &kp LS(N9)                   &kp NUMBER_8           &kp COMMA
                                           &trans               &kp CAPS                    &trans                         &kp ESCAPE        &trans  &trans     &trans                           &trans
                                                                                                                                             &trans
            >;

            label = "Symbol";
        };

        Navi {
            bindings = <
&trans  &kp F4            &kp F3            &kp F2              &kp F1                &kp C_VOLUME_UP      &trans  &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &none   &trans
&trans  &hmr LEFT_GUI F8  &hmr LEFT_ALT F7  &hmr LEFT_SHIFT F6  &hmr LEFT_CONTROL F5  &kp C_VOLUME_DOWN    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none   &trans
&trans  &kp F12           &kp F11           &kp F10             &kp F9                &kp K_MUTE           &trans  &trans          &trans          &trans        &trans           &trans  &trans
                          &trans            &trans              &trans                &trans               &trans  &trans          &trans          &trans
                                                                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
            label = "Navi";
        };

        Flash {
            bindings = <
&flash_macro  &trans  &trans  &trans  &trans  &trans    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &studio_unlock
&trans        &trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans        &trans        &trans        &kp A
&trans        &trans  &trans  &trans  &trans  &trans    &trans  &bt BT_CLR    &none         &trans        &trans        &trans        &bt BT_CLR_ALL
                      &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans
                                                        &trans
            >;

            label = "Flash";
        };

        Rgb {
            bindings = <
&ext_power EP_TOG  &trans  &trans  &trans  &trans           &rgb_ug RGB_SPI    &rgb_ug RGB_HUI  &rgb_ug RGB_SPD  &trans           &trans  &trans  &trans  &trans
&trans             &trans  &trans  &trans  &rgb_ug RGB_BRI  &rgb_ug RGB_EFR    &rgb_ug RGB_HUD  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &trans  &trans  &trans  &trans
&trans             &trans  &trans  &trans  &trans           &trans             &rgb_ug RGB_SAI  &trans           &trans           &trans  &trans  &trans  &trans
                           &to 0   &trans  &trans           &trans             &rgb_ug RGB_SAD  &trans           &trans           &trans
                                                                               &rgb_ug RGB_TOG
            >;

            label = "Rgb";
            sensor-bindings = <&rgb_encoder &scroll_encoder>;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans       &mmv MOVE_UP     &trans     &trans     &trans  &trans  &trans          &trans
&trans  &trans  &trans  &trans  &trans     &trans       &mmv MOVE_DOWN   &kp A      &trans     &trans  &trans  &trans          &trans
&trans  &trans  &trans  &trans  &trans     &trans       &mmv MOVE_LEFT   &trans     &trans     &trans  &trans  &rgb_ug RGB_ON  &trans
                &trans  &trans  &mkp LCLK  &mkp RCLK    &mmv MOVE_RIGHT  &mkp LCLK  &mkp RCLK  &trans
                                                        &to 0
            >;

            label = "Mouse";
            sensor-bindings = <&scroll_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        flash {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
