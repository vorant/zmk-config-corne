#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 100   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 3 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <40>;       // 300
    delay-ms = <16>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

/ {
    macros {
        flash_macro: flash_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bootloader>;
        };
    };

    behaviors {
        hml: homerow_mods_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS_LEFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            hold-trigger-key-positions = <21 22 23>;
            hold-trigger-on-release;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };

        as: auto_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "AUTO_SHIFT";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <135>;
            quick-tap-ms = <0>;
        };

        rgb_encoder: rgb_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            label = "RGB_ENCODER";
            #sensor-binding-cells = <0>;
            bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
        };

        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <30>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
            flavor = "balanced";
            require-prior-idle-ms = <125>;
            hold-trigger-key-positions = <17 16 15 14>;
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        left_bkt {
            bindings = <&kp LS(LA(PERIOD))>;
            key-positions = <3 4>;
        };

        right_bkt {
            bindings = <&kp LS(LA(SLASH))>;
            key-positions = <9 8>;
        };

        left_par {
            bindings = <&kp NUMBER_9>;
            key-positions = <16 17>;
        };

        right_par {
            bindings = <&kp NUMBER_0>;
            key-positions = <21 22>;
        };

        left_brace {
            bindings = <&kp LA(PERIOD)>;
            key-positions = <29 30>;
        };

        right_brace {
            bindings = <&kp LA(SLASH)>;
            key-positions = <34 35>;
        };

        bac {
            bindings = <&kp BACKSLASH>;
            key-positions = <5 7>;
        };

        pipe {
            bindings = <&kp PIPE>;
            key-positions = <18 20>;
        };

        less {
            bindings = <&kp LA(O)>;
            key-positions = <16 17 23>;
        };

        more {
            bindings = <&kp LA(P)>;
            key-positions = <21 22 15>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Qwery {
            bindings = <
&trans        &kp Q            &kp W            &kp E              &kp R                   &as LA(T) T      &kp UP_ARROW     &kp Y          &kp U                 &as LA(I) I         &kp O             &kp P                     &trans
&kp CAPSLOCK  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LEFT_SHIFT D  &hml LEFT_CONTROL F     &kp G            &kp DOWN_ARROW   &kp H          &hmr RIGHT_CONTROL J  &hmr RIGHT_SHIFT K  &hmr RIGHT_ALT L  &hmr RIGHT_GUI SEMICOLON  &trans
&trans        &kp Z            &kp X            &kp C              &kp V                   &kp B            &kp LEFT_ARROW   &kp N          &as LA(M) M           &kp COMMA           &kp DOT           &kp SLASH                 &trans
                               &to 5            &ltq 3 TAB         &as LEFT_CONTROL SPACE  &ltq 2 DELETE    &kp RIGHT_ARROW  &kp BACKSPACE  &kp ENTER             &ltq 1 ESCAPE
                                                                                                            &to 6
            >;

            label = "Qwery";
            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        Navi {
            bindings = <
&trans  &trans        &trans        &bt BT_SEL 1    &bt BT_SEL 0      &kp C_VOLUME_UP      &trans  &trans  &kp HOME        &kp UP_ARROW    &kp END          &kp PG_UP      &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp C_VOLUME_DOWN    &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp PAGE_DOWN  &trans
&trans  &trans        &trans        &trans          &trans            &kp K_MUTE           &trans  &trans  &trans          &trans          &trans           &trans         &trans
                      &trans        &trans          &trans            &trans               &trans  &trans  &trans          &trans
                                                                                           &trans
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
            label = "Navi";
        };

        Symbol {
            bindings = <
&none  &none  &kp NUMBER_3  &kp NUMBER_2  &none         &none     &trans  &kp SEMICOLON   &kp NUMBER_1                      &kp NUMBER_7                   &kp RA(GRAVE)         &kp LS(BACKSLASH)         &trans
&none  &none  &kp NUMBER_6  &kp N5        &kp NUMBER_4  &none     &trans  &kp MINUS       &hmr RIGHT_CONTROL RIGHT_BRACKET  &hmr RIGHT_SHIFT LEFT_BRACKET  &hmr RIGHT_ALT GRAVE  &hmr RIGHT_GUI BACKSLASH  &trans
&none  &none  &none         &none         &kp COMMA     &none     &trans  &kp UNDERSCORE  &kp LS(RIGHT_BRACKET)             &kp LS(LEFT_BRACKET)           &kp LS(GRAVE)         &kp LA(BACKSLASH)         &trans
              &trans        &trans        &trans        &trans    &trans  &trans          &trans                            &trans
                                                                  &trans
            >;

            label = "Symbol";
        };

        Numbers {
            bindings = <
&trans  &trans        &trans        &trans          &trans            &trans            &trans  &kp PLUS   &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp NUMBER_8     &trans
&trans  &kp LEFT_GUI  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp KP_NUMLOCK    &trans  &kp MINUS  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_NUMBER_0  &trans
&trans  &trans        &trans        &trans          &trans            &trans            &trans  &kp EQUAL  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp BACKSLASH    &trans
                      &trans        &trans          &trans            &trans            &trans  &trans     &trans           &trans
                                                                                        &trans
            >;

            label = "Numbers";
        };

        Flash {
            bindings = <
&flash_macro  &trans  &trans  &trans  &trans  &trans    &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans
&trans        &trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans        &trans        &trans        &trans
&trans        &trans  &trans  &trans  &trans  &trans    &trans  &bt BT_CLR    &trans        &trans        &trans        &trans        &bt BT_CLR_ALL
                      &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans
                                                        &trans
            >;

            label = "Flash";
        };

        Rgb {
            bindings = <
&ext_power EP_TOG  &trans  &trans  &trans  &trans           &rgb_ug RGB_SPI    &rgb_ug RGB_HUI  &rgb_ug RGB_SPD  &trans           &trans  &trans  &trans  &trans
&trans             &trans  &trans  &trans  &rgb_ug RGB_BRI  &rgb_ug RGB_EFR    &rgb_ug RGB_HUD  &rgb_ug RGB_EFF  &rgb_ug RGB_BRD  &trans  &trans  &trans  &trans
&trans             &trans  &trans  &trans  &trans           &trans             &rgb_ug RGB_SAI  &trans           &trans           &trans  &trans  &trans  &trans
                           &to 0   &trans  &trans           &trans             &rgb_ug RGB_SAD  &trans           &trans           &trans
                                                                               &rgb_ug RGB_TOG
            >;

            label = "Rgb";
            sensor-bindings = <&rgb_encoder &scroll_encoder>;
        };

        Mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans     &trans       &mmv MOVE_UP     &trans     &trans     &trans  &trans  &trans          &trans
&trans  &trans  &trans  &trans  &trans     &trans       &mmv MOVE_DOWN   &kp A      &trans     &trans  &trans  &trans          &trans
&trans  &trans  &trans  &trans  &trans     &trans       &mmv MOVE_LEFT   &trans     &trans     &trans  &trans  &rgb_ug RGB_ON  &trans
                &trans  &trans  &mkp LCLK  &mkp RCLK    &mmv MOVE_RIGHT  &mkp LCLK  &mkp RCLK  &trans
                                                        &to 0
            >;

            label = "Mouse";
            sensor-bindings = <&scroll_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        Flash {
            if-layers = <3 2>;
            then-layer = <4>;
        };
    };
};
